<?xml version="1.0" encoding="utf-8"?>
<!--
  钥匣图标前景：钥匙（环 + 柄 + 齿）+ 匣底托弧。
  108dp 视口，主图形全部落在 66dp 安全圆内（21..87），
  任何厂商遮罩（圆 / 圆角方 / 水滴）裁切都不会切到主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 钥匙环 -->
    <path
        android:pathData="M41.5,46 a12.5,12.5 0 1,0 25,0 a12.5,12.5 0 1,0 -25,0"
        android:fillColor="#00000000"
        android:strokeWidth="6.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="41"
                android:startY="33"
                android:endX="67"
                android:endY="59"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFD9C8FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 钥匙柄 -->
    <path
        android:pathData="M54,58.5 L54,76"
        android:fillColor="#00000000"
        android:strokeColor="#FFEFE7FF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- 钥匙齿（一长一短，像真钥匙） -->
    <path
        android:pathData="M54,68 L65,68"
        android:fillColor="#00000000"
        android:strokeColor="#FFEFE7FF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,76 L61,76"
        android:fillColor="#00000000"
        android:strokeColor="#FFEFE7FF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- 匣底托弧：把「钥」接在「匣」上 -->
    <path
        android:pathData="M39,82.5 Q54,88.5 69,82.5"
        android:fillColor="#00000000"
        android:strokeColor="#8CFFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
</vector>
